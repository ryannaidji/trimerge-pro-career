# Backend environment variables example
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/trimerge-pro-careers
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=10
BCRYPT_ROUNDS=10
# Comma-separated allowlist of browser origins. No "*"; HTTPS only in production
CORS_ORIGIN=http://localhost:3000
# Email: "console" prints emails (and OTP codes) in the API logs; "mailgun" sends them
MAIL_DRIVER=console
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER=
# File storage: "local" writes to ./uploads; "cloudinary" needs CLOUDINARY_URL
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
PUBLIC_API_URL=http://localhost:4000
CLOUDINARY_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MATCHING_ENABLED=false
# Max paid AI evaluations per month (also set a spending limit in the OpenAI dashboard)
AI_MATCHING_MONTHLY_LIMIT=500
